# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing CDN (AWS CloudFront) — current live product images
NEXT_PUBLIC_CDN_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Email
RESEND_API_KEY=

# Cloudflare R2 (object storage for images, video, PDFs, and documents)
# Set these up in the Cloudflare dashboard: R2 > Create bucket, then
# R2 > Manage API tokens > Create API token (Object Read & Write).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for reading objects back out — either a custom domain
# connected to the bucket (recommended for production) or the bucket's
# r2.dev public development URL.
NEXT_PUBLIC_R2_PUBLIC_URL=

# Admin panel (/admin) — protects product image management behind a
# shared password. Generate ADMIN_SESSION_SECRET with `openssl rand -hex 32`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
